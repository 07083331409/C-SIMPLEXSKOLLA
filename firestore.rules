rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated user to read their own profile and create/update their own profile record.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // School profile access is allowed only when the authenticated user is linked to the school.
    match /schools/{schoolId} {
      allow read: if request.auth != null && isAuthorizedSchool(request.auth.uid, schoolId);
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.schoolId == schoolId
        && request.resource.data.schoolName is string
        && request.resource.data.status == "active";
      allow update: if request.auth != null && isAuthorizedSchool(request.auth.uid, schoolId);
      allow delete: if false;
    }

    // Student document access requires the user to belong to the same school.
    match /schools/{schoolId}/students/{studentId} {
      allow read, write: if request.auth != null && isAuthorizedSchool(request.auth.uid, schoolId);
    }

    function isAuthorizedSchool(uid, schoolId) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId;
    }
  }
}
